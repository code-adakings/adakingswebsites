# Sanity project — from https://www.sanity.io/manage (or `npx sanity@latest init`)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Shared secret configured on the Sanity webhook that POSTs to /api/revalidate
# on publish (Studio → API → Webhooks). Generate any random string.
SANITY_REVALIDATE_SECRET=

# Viewer token (Sanity → API → Tokens, "Viewer" role) used server-side to read
# draft/unpublished content for Draft Mode (/api/draft) and preview fetches.
# Never expose this to the client — no NEXT_PUBLIC_ prefix.
SANITY_API_READ_TOKEN=

# Optional. Origin the Studio Presentation tool's preview iframe should open
# (e.g. https://staging.adakings.com). Leave unset to default to wherever
# /studio itself is hosted (location.origin) — correct for this project since
# Studio is embedded in the same Next.js app as the frontend.
NEXT_PUBLIC_SANITY_STUDIO_PREVIEW_URL=

# Analytics — optional. Leave unset to skip loading the corresponding script
# (site behaves the same, tracking is just a no-op).
# GA4 Measurement ID (Google Analytics → Admin → Data Streams), e.g. G-XXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel ID (Meta Events Manager → Data Sources)
NEXT_PUBLIC_META_PIXEL_ID=
